# All optional. The app reads real environment variables (no .env loader is included).
# Local database file (default: reclaim.db in the project root)
RECLAIM_DB=reclaim.db
# Extra allowed Host headers, comma-separated (default: none)
RECLAIM_EXTRA_HOSTS=
# Optional live screenshot-reading provider: set RECLAIM_EXTRACTION_PROVIDER=anthropic and a key, or leave both unset for local rules and fixtures
#RECLAIM_EXTRACTION_PROVIDER=anthropic
#ANTHROPIC_API_KEY=<your-key>
RECLAIM_EXTRACTION_TIMEOUT=45
